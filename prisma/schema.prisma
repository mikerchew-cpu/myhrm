generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  email          String   @unique
  givenName      String
  surname        String
  role           String   @default("Viewer")
  department     String   @default("")
  hierarchyLevel Int      @default(1)
  approvalLevel  Int      @default(1)
  status         String   @default("Active")
  passwordHash   String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AiProvider {
  id        String   @id @default(cuid())
  provider  String   @unique
  apiKey    String   @default("")
  endpoint  String   @default("")
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id             String          @id @default(cuid())
  employeeId     String          @unique
  name           String
  role           String
  department     String
  employmentType String
  status         String          @default("Active")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  claims         Claim[]
  leaveRequests  LeaveRequest[]
  overtimeLogs   OvertimeLog[]
  attendance     Attendance[]
  mileageRecords MileageRecord[]
  performance    Performance?
  foreignWorker  ForeignWorker?
  approvals      Approval[]
  payrollRecords PayrollRecord[]
}

model Claim {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        String
  date        DateTime
  fromLocation String  @default("")
  toLocation  String   @default("")
  distance    Float    @default(0)
  rate        Float    @default(0.6)
  amount      Float    @default(0)
  receipt     String   @default("")
  remarks     String   @default("")
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LeaveRequest {
  id        String   @id @default(cuid())
  employeeId String
  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type      String
  halfDay   String   @default("Full day")
  startDate DateTime
  endDate   DateTime
  reason    String   @default("")
  mcFile    String   @default("")
  status    String   @default("Pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OvertimeLog {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  hours      Float    @default(0)
  dayType    String   @default("Normal workday")
  multiplier Float    @default(1.5)
  rate       Float    @default(0)
  amount     Float    @default(0)
  status     String   @default("Pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  clockIn    String   @default("")
  clockOut   String   @default("")
  status     String   @default("Present")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MileageRecord {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime
  fromLocation String  @default("")
  toLocation  String   @default("")
  distance    Float    @default(0)
  amount      Float    @default(0)
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Approval {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        String
  referenceId String
  level       Int      @default(1)
  status      String   @default("Pending")
  comment     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Performance {
  id         String   @id @default(cuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  score      Int      @default(0)
  quarter    String   @default("Q2")
  year       Int      @default(2026)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ForeignWorker {
  id            String   @id @default(cuid())
  employeeId    String   @unique
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  nationality   String
  permitType    String
  permitExpiry  DateTime?
  levyPaid      Boolean  @default(false)
  fomemaStatus  String   @default("Pending")
  securityBond  Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LevyRecord {
  id         String   @id @default(cuid())
  sector     String
  nationality String
  workerCount Int     @default(1)
  levyRate   Float    @default(1850)
  totalCost  Float    @default(0)
  createdAt  DateTime @default(now())
}

model Skill {
  id         String   @id @default(cuid())
  title      String
  department String   @default("")
  content    String   @default("")
  filename   String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PayrollRecord {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month      Int
  year       Int
  gross      Float    @default(0)
  epf        Float    @default(0)
  socso      Float    @default(0)
  eis        Float    @default(0)
  net        Float    @default(0)
  status     String   @default("Draft")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model JobPosting {
  id           String        @id @default(cuid())
  title        String
  department   String        @default("")
  location     String        @default("")
  type         String        @default("Permanent")
  salaryMin    Float         @default(0)
  salaryMax    Float         @default(0)
  description  String        @default("")
  requirements String        @default("")
  status       String        @default("Draft")
  closingDate  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applicants   Applicant[]
  interviews   Interview[]
}

model Applicant {
  id           String        @id @default(cuid())
  jobPostingId String
  jobPosting   JobPosting    @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  name         String
  email        String        @default("")
  phone        String        @default("")
  source       String        @default("")
  stage        String        @default("New")
  status       String        @default("New")
  rating       Int           @default(0)
  resume       String        @default("")
  coverLetter  String        @default("")
  notes        String        @default("")
  appliedDate  DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  interviews   Interview[]
}

model Interview {
  id           String        @id @default(cuid())
  applicantId  String
  applicant    Applicant     @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  jobPostingId String
  jobPosting   JobPosting    @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  interviewer  String        @default("")
  type         String        @default("HR")
  mode         String        @default("Video")
  date         DateTime?
  duration     Int           @default(60)
  feedback     String        @default("")
  rating       Int           @default(0)
  status       String        @default("Scheduled")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Document {
  id          String    @id @default(cuid())
  title       String
  type        String    @default("")
  department  String    @default("")
  employeeId  String    @default("")
  fileUrl     String    @default("")
  issueDate   DateTime?
  expiryDate  DateTime?
  status      String    @default("Active")
  notes       String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ESubmission {
  id          String   @id @default(cuid())
  type        String
  title       String
  periodMonth Int
  periodYear  Int
  content     String   @default("")
  recordCount Int      @default(0)
  totalAmount Float    @default(0)
  status      String   @default("Generated")
  notes       String   @default("")
  createdAt   DateTime @default(now())
}

model Training {
  id            String    @id @default(cuid())
  title         String
  provider      String    @default("")
  type          String    @default("")
  cost          Float     @default(0)
  employeeId    String    @default("")
  employeeName  String    @default("")
  startDate     DateTime?
  endDate       DateTime?
  status        String    @default("Planned")
  certification String    @default("")
  notes         String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Asset {
  id           String   @id @default(cuid())
  name         String
  type         String   @default("")
  serialNo     String   @default("")
  employeeId   String   @default("")
  employeeName String   @default("")
  purchaseDate DateTime?
  purchasePrice Float   @default(0)
  status       String   @default("Assigned")
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model JobChange {
  id            String   @id @default(cuid())
  employeeId    String   @default("")
  employeeName  String   @default("")
  changeType    String
  previousValue String   @default("")
  newValue      String   @default("")
  effectiveDate DateTime?
  reason        String   @default("")
  approvedBy    String   @default("")
  notes         String   @default("")
  createdAt     DateTime @default(now())
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String   @default("")
  category    String   @default("General")
  priority    String   @default("Normal")
  author      String   @default("")
  publishDate DateTime @default(now())
  expiryDate  DateTime?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
